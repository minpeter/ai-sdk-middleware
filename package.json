{
  "name": "@ai-sdk-tool/middleware",
  "version": "0.0.3",
  "description": "Collection of reusable AI SDK middlewares",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/minpeter/ai-sdk-middleware"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./reasoning-parser": {
      "types": "./dist/reasoning-parser.d.ts",
      "import": "./dist/reasoning-parser.js",
      "require": "./dist/reasoning-parser.cjs"
    },
    "./disk-cache": {
      "types": "./dist/disk-cache.d.ts",
      "import": "./dist/disk-cache.js",
      "require": "./dist/disk-cache.cjs"
    },
    "./evlog": {
      "types": "./dist/evlog.d.ts",
      "import": "./dist/evlog.js",
      "require": "./dist/evlog.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsup --tsconfig tsconfig.build.json && tsc -p tsconfig.build.json",
    "build:watch": "pnpm clean && tsup --watch --tsconfig tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:biome": "biome check",
    "check:types": "pnpm run typecheck",
    "check": "pnpm run check:biome && pnpm run check:types",
    "fmt:biome": "biome check --write",
    "fmt": "pnpm run fmt:biome",
    "changeset": "changeset",
    "ci:release": "pnpm build && changeset publish",
    "ci:version": "changeset version"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "ai": ">=7.0.0 <8.0.0",
    "evlog": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "evlog": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.2",
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "2.31.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ai": "7.0.18",
    "evlog": "2.20.0",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "ultracite": "7.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "keywords": [
    "ai",
    "sdk",
    "middleware",
    "ai-sdk",
    "language-model-v4",
    "evlog"
  ],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
